{
  "name": "crossborder-delivery-skill",
  "version": "1.0.0",
  "description": "跨境电商全链路：给品类+法域+候选数，产出一份能被人接手提交的上品包，每段留可回放台账。覆盖 8 平台 × 9 法域。",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "cross-border",
    "ecommerce",
    "ozon",
    "wildberries",
    "shopee",
    "lazada",
    "amazon",
    "noon",
    "listing",
    "rpa",
    "skill"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "import": "node scripts/import-history.mjs",
    "doctor": "node scripts/doctor.mjs",
    "demo": "node scripts/demo.mjs",
    "pack": "node scripts/pack.mjs",
    "chain": "node scripts/chain.mjs",
    "llm:probe": "node scripts/llm-probe.mjs",
    "selfgrade": "node scripts/selfgrade.mjs",
    "test": "node --test",
    "check:decouple": "node scripts/gates/check-decouple.mjs",
    "add-region": "node scripts/add-region.mjs",
    "evidence:chain": "node scripts/chain-evidence.mjs",
    "lookbook": "node scripts/lookbook.mjs",
    "pack:submission": "node scripts/pack-submission.mjs",
    "intake": "node scripts/intake.mjs",
    "sizing:confirm": "node scripts/confirm-sizing.mjs",
    "quickstart": "node scripts/quickstart.mjs",
    "ozon:rules": "node scripts/probe-ozon-attribute-rules.mjs",
    "ozon:scopes": "node scripts/probe-ozon-scopes.mjs",
    "evals": "node evals/run.mjs",
    "copy:plan": "node scripts/copy.mjs --plan",
    "copy:check": "node scripts/copy.mjs --check",
    "signals:probe": "node scripts/probe-signal-sources.mjs",
    "check:attrs": "node scripts/check-attrs-coverage.mjs",
    "title:check": "node scripts/check-title.mjs",
    "cost:estimate": "node scripts/cost-estimate.mjs",
    "signals:sample": "node scripts/sample-signals.mjs",
    "mcp": "node mcp/server.mjs",
    "preflight:store": "node scripts/preflight-store.mjs",
    "platform:readiness": "node scripts/probe-platform-readiness.mjs",
    "ozon:dict": "node scripts/probe-ozon-dictionary.mjs",
    "region:data": "node scripts/probe-region-data.mjs",
    "region:calendar": "node scripts/probe-region-calendar.mjs",
    "research:render": "node scripts/render-research-registry.mjs",
    "fx:refresh": "node scripts/probe-fx.mjs",
    "probe:account": "node scripts/probe-account.mjs",
    "trade:probe": "node scripts/probe-trade.mjs",
    "holidays:probe": "node scripts/probe-region-calendar.mjs",
    "ci": "node --test && node scripts/gates/check-decouple.mjs && node evals/run.mjs",
    "market:scan": "node scripts/market-scan.mjs",
    "select:candidates": "node scripts/select-candidates.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "sharp": "^0.35.5"
  }
}
