{
  "version": 1,
  "as_of": "2026-11-01",
  "why": "跨境电商要判断的不是「这个货好不好」，而是「这个货在这个市场、这个平台、这个时间点能不能卖」。下面每一格都是一个会改变结论的输入。空着的格子不是不重要，是还没取到。",
  "status_legend": {
    "final": "已取到官方/权威数据，可直接用于判断（L2）",
    "candidate": "已取到但来源为二手或需人工确认（L1）",
    "unverified": "未取到，不得用于判断",
    "paid": "只有付费源，未采购",
    "blocked": "公开渠道实测不可达，需账号/授权",
    "manual": "只能人工取样，已提供工具"
  },
